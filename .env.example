# Copy this file to .env and fill in your actual values.
# The same variables must also be set in Netlify → Site configuration → Environment variables.

# --- EmailJS (contact form, used in the browser) ---
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# --- Event photo uploads (server side only, used by Netlify Functions) ---
# From the UploadThing dashboard → your app → API Keys
UPLOADTHING_TOKEN=your_uploadthing_token_here
# Password for the /admin upload page. Pick something long.
ADMIN_PASSWORD=change_me
